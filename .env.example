# Шаблон переменных окружения. Скопируйте в .env (он в .gitignore) и заполните ТОЛЬКО нужное.
# В репозиторий попадает лишь этот файл — с пустыми значениями. Ключи никогда не пишутся в код и документы.
# Для работы в Claude Code / Cursor ключи НЕ нужны: модель предоставляет сама среда.

# --- Опционально: прямой вызов моделей из скриптов (если вы добавите такие сценарии) ---
# Anthropic API (https://console.anthropic.com), формат sk-ant-...
ANTHROPIC_API_KEY=
# OpenAI API, формат sk-...
OPENAI_API_KEY=
# Yandex Cloud (YandexGPT): API-ключ сервисного аккаунта и ID каталога
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
# GigaChat: авторизационные данные (Base64 client_id:client_secret)
GIGACHAT_CREDENTIALS=

# --- Опционально: сеть ---
# Корневой сертификат НУЦ Минцифры для сайтов РФ — только осознанно, см. docs/SECURITY.md (файл хранить вне репозитория)
SA_EXTRA_CA_FILE=
# Прокси для sa.py source fetch, если без него сайты недоступны (пример: http://proxy:3128)
HTTPS_PROXY=
