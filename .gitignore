# --- Секреты: только локально, никогда в репозитории (см. docs/SECURITY.md) ---
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
.claude/settings.local.json

# --- Сырые интервью с персональными данными: хранить вне репозитория ---
projects/*/interviews/raw/
projects/*/interviews/*.audio/
*.m4a
*.wav

# --- Служебное ---
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
scratch/
*.tmp
*.lock
